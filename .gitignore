# ==============================================================================
# Root .gitignore — Park Auto MEF (Monorepo: Spring Boot Backend + React Frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# Frontend & Node.js (park-auto-frontend)
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
.output/
.turbo/
.cache/
.eslintcache
.parcel-cache/

# Node package manager logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Frontend environment variables & local overrides
.env.local
.env.*.local
*.local

# ------------------------------------------------------------------------------
# Backend & Java / Spring Boot / Maven (park-auto-mef)
# ------------------------------------------------------------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Maven wrapper executable binaries (if any)
!.mvn/wrapper/maven-wrapper.jar

# ------------------------------------------------------------------------------
# Databases & Local Embedded Storage
# ------------------------------------------------------------------------------
data/
*.mv.db
*.trace.db
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# Python & Scripts
# ------------------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyo
.pytest_cache/
.coverage
htmlcov/
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------------------------
# Logs & Temporary Files
# ------------------------------------------------------------------------------
*.log
logs/
temp/
tmp/
tmp_final_render/
*.tmp
*.temp

# ------------------------------------------------------------------------------
# IDEs & Code Editors
# ------------------------------------------------------------------------------
# JetBrains (IntelliJ IDEA, WebStorm, etc.)
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

# Visual Studio Code
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

# Eclipse
.metadata/
.classpath
.project
.settings/
*.launch
bin/

# Sublime / NetBeans
*.sublime-workspace
*.sublime-project
nbproject/private/

# AI Assistants, Local Tooling & Graphify Caches
.claude/
.codex/
.gemini/
graphify-out/cache/
graphify-out/20*/

# ------------------------------------------------------------------------------
# Operating System Generated Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

# Linux
*~
