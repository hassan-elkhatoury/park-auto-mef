# ==============================================================================
# .gitignore — PARK AUTO MEF (Ministère de l'Économie et des Finances)
#
# Dépôt GitHub restreint exclusivement aux composants essentiels du projet :
#   1. park-auto-mef/      (Backend Spring Boot 3 & API REST)
#   2. park-auto-frontend/ (Frontend React 19 / Vite / Tailwind CSS)
#   3. README.md           (Documentation officielle)
#   4. docker-compose.yml  (Orchestration Docker multi-conteneurs)
#   5. .env.example        (Gabarit des variables d'environnement)
#   6. .gitignore          (Ce fichier)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. RAPPORTS, PLANNINGS & DOCUMENTS DE RÉDACTION (STRICTEMENT EXCLUS)
# ------------------------------------------------------------------------------
rapports/
planning/
docs/
assets/
tmp_final_render/
_tmp_*
_tmp_*/
*.bak
*.bak.*
*.csv
*.docx
*.pdf
*.pptx
*.xlsx
*.xls
~$*

# Documents de travail, contextes et dumps d'analyse
CONSOLIDATED_PROJECT_CONTEXT.md
GUIDE_PRESENTATION_PAGES_PARK_AUTO_MEF.md
AGENTS.md

# Fichiers JSON intermédiaires à la racine
/*.json

# ------------------------------------------------------------------------------
# 2. SCRIPTS PYTHON & OUTILS DE GÉNÉRATION (EXCLUS)
# ------------------------------------------------------------------------------
scripts/
*.py
*.py[cod]
*$py.class
__pycache__/
.venv/
venv/
env/
ENV/

# ------------------------------------------------------------------------------
# 3. OUTILS IA, CACHES & ASSISTANTS
# ------------------------------------------------------------------------------
.claude/
.cursor/
.vscode/
.codex/
.gemini/
graphify-out/

# ------------------------------------------------------------------------------
# 4. FRONTEND (park-auto-frontend) — DÉPENDANCES & BUILDS
# ------------------------------------------------------------------------------
node_modules/
dist/
dist-ssr/
build/
.vite/
.output/
.turbo/
.cache/
.parcel-cache/
.eslintcache

# Logs Node
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Variables d'environnement locales (Secrets)
.env
.env.local
.env.*.local
*.local
!.env.example

# Stockage GED local
uploads/
backups/

# ------------------------------------------------------------------------------
# 5. BACKEND (park-auto-mef) — MAVEN & COMPILATION
# ------------------------------------------------------------------------------
target/
*.class
*.jar
*.war
*.ear
*.nar
*.zip
*.tar.gz
*.rar

# Bases de données locales
data/
*.mv.db
*.trace.db
*.db
*.sqlite
*.sqlite3

# ------------------------------------------------------------------------------
# 6. IDEs & ÉDITEURS DE CODE
# ------------------------------------------------------------------------------
.idea/
*.iml
*.iws
*.ipr
out/
.idea_modules/

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
*.code-workspace

.metadata/
.classpath
.project
.settings/
bin/
*.sublime-workspace
*.sublime-project
nbproject/

# ------------------------------------------------------------------------------
# 7. FICHIERS SYSTÈMES & TEMPORAIRES
# ------------------------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/

*.log
logs/
temp/
tmp/
*.tmp
*.temp
*~
