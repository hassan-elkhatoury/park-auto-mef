# ==============================================================================
# Variables d'environnement — Park Auto MEF
# Copier ce fichier vers `.env` (jamais versionné) et renseigner les valeurs.
# ==============================================================================

# --- Base de données PostgreSQL ---
DB_NAME=park_auto_mef
DB_USERNAME=parkauto
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_fort

# Première initialisation : update. Ensuite : validate (schéma géré par l'exploitant).
DDL_AUTO=update

# --- JWT ---
# Générer : openssl rand -base64 48
JWT_SECRET=CHANGEZ_MOI_chaine_aleatoire_de_48_octets_minimum_base64
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=14400000

# --- Compte administrateur initial (changement forcé au 1er login) ---
ADMIN_EMAIL=admin@mef.gov.ma
ADMIN_PASSWORD=CHANGEZ_MOI_Admin_Initial_2026!

# --- CORS (origines du frontend, séparées par des virgules) ---
CORS_ALLOWED_ORIGINS=http://localhost

# --- SMTP (alertes e-mail) ---
MAIL_HOST=smtp.mef.gov.ma
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=parc-auto@mef.gov.ma

# --- Divers ---
HTTP_PORT=80
SWAGGER_ENABLED=false
