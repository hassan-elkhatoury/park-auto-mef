@startuml
!include _theme.puml
title Cas d'utilisation - Conducteurs, affectations et missions
left to right direction

actor "Agent\ndemandeur" as agent
actor "Responsable\nService" as rs
actor "Gestionnaire\nParc" as gp
actor "Conducteur" as cd

rectangle "Module Missions & Affectations" {
  usecase "Soumettre une demande\nde deplacement" as demande
  usecase "Valider niveau 1\n(Service)" as valider
  usecase "Approuver et affecter\n(vehicule + chauffeur)" as affecter
  usecase "Generer l'ordre\nde mission (PDF)" as om
  usecase "Effectuer la restitution\n(km retour)" as restitution
  usecase "Gerer les conducteurs\nagrees" as conducteurs
}

agent --> demande
rs --> valider
gp --> affecter
gp --> om
gp --> restitution
gp --> conducteurs
cd --> restitution

valider .> demande : <<extend>>
affecter .> om : <<include>>
@enduml
