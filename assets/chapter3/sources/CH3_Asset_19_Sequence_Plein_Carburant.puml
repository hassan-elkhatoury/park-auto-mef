@startuml
!include _theme.puml
title Sequence - Saisie d'un plein et controle kilometrique
autonumber

actor "Conducteur / Gestionnaire" as u
participant "CarburantView\nReact" as view
participant CarburantController as controller
participant CarburantService as service
database VehiculeRepository as repo

u -> view : saisir le plein (litres, montant, km)
view -> controller : POST /api/carburant/pleins
controller -> service : enregistrerPlein(dto)
service -> repo : findById(vehiculeId)
repo --> service : Vehicule (kilometrageActuel)

alt km saisi < kilometrageActuel
  service --> controller : ValidationException
  controller --> view : HTTP 400 (km incoherent)
  view --> u : message d'erreur
else km coherent
  service -> service : conso = litres / (km - kmPrecedent) * 100
  alt conso > consommationTheorique
    service -> service : anomalieSurconsommation = true
  end
  service -> repo : UPDATE kilometrageActuel\nINSERT PleinCarburant
  service --> controller : PleinResponse (conso, anomalie)
  controller --> view : HTTP 201 ApiResponse
  view --> u : plein enregistre + alerte eventuelle
end
@enduml
