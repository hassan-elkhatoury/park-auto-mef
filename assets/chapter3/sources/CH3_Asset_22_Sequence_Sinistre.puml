@startuml
!include _theme.puml
title Sequence - Declaration et traitement d'un sinistre
autonumber

actor "Gestionnaire" as ge
participant "AssurancesView\nReact" as view
participant SinistreController as controller
participant SinistreService as service
database "PostgreSQL" as db

ge -> view : renseigner le constat d'accident
view -> controller : POST /api/sinistres/declarer
controller -> service : declarer(dto) [DECLARE]
service -> db : INSERT Sinistre\n(lie a une Assurance + Vehicule)
service --> controller : SinistreResponse
controller --> view : HTTP 201 ApiResponse

ge -> view : lancer l'expertise
view -> controller : PUT /api/sinistres/{id}
controller -> service : mettreAJour() [EN_EXPERTISE]
service -> db : UPDATE statut
controller --> view : HTTP 200

ge -> view : enregistrer l'indemnisation
view -> controller : PUT /api/sinistres/{id}
controller -> service : cloturer() [INDEMNISE -> CLOS]
service -> db : UPDATE montant + statut
controller --> view : HTTP 200 ApiResponse
@enduml
