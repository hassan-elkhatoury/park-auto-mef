@startuml
!include _theme.puml
title Sequence - Rafraichissement de session JWT
autonumber

actor Utilisateur as user
participant "Application React" as app
participant "Axios Interceptor" as axios
participant AuthController as controller
participant JwtService as jwt
database UtilisateurRepository as repo
participant AuditService as audit

user -> app : action metier
app -> axios : requete avec Access Token
axios -> controller : GET /api/ressource
controller --> axios : HTTP 401 - token expire
axios -> controller : POST /api/auth/refresh\nRefresh Token
controller -> jwt : verifier signature, type et expiration

alt Refresh Token invalide ou expire
  jwt --> controller : validation echouee
  controller -> audit : REFRESH_FAILED
  controller --> axios : HTTP 401
  axios -> app : supprimer tokens locaux
  app --> user : redirection /login
else Refresh Token valide
  jwt --> controller : username
  controller -> repo : findByEmail(username)
  repo --> controller : Utilisateur
  alt utilisateur absent ou statut != ACTIVE
    controller -> audit : REFRESH_BLOCKED
    controller --> axios : HTTP 403
    axios -> app : fermer la session
  else utilisateur actif
    controller -> jwt : generateAccessToken(user)
    jwt --> controller : nouvel Access Token
    controller -> audit : TOKEN_REFRESHED
    controller --> axios : HTTP 200 + accessToken
    axios -> controller : repeter la requete initiale
    controller --> axios : HTTP 200 + donnees
    axios --> app : donnees metier
    app --> user : interface mise a jour
  end
end
@enduml

