@startuml
!include _theme.puml
title Architecture applicative en couches
top to bottom direction

actor "Utilisateurs MEF\n7 roles RBAC" as users

rectangle "INTERFACE REACT / TYPESCRIPT\nComposants - Formulaires - Tableaux - Dashboards" as frontend #E9F7F9
rectangle "COUCHE EXPOSITION\nControllers REST Spring MVC\nApiResponse<T> - Bean Validation - @RestControllerAdvice" as controllers #EEF4F8
rectangle "COUCHE METIER\nServices - Regles MEF - @Transactional - Audit" as business #FFFFFF
rectangle "DTO & MAPPING\nRecords DTO - MapStruct" as mapping #FFF9ED
rectangle "COUCHE PERSISTANCE\nRepositories Spring Data JPA - Specifications" as repositories #F3F5F8
database "PostgreSQL\nBase relationnelle" as database

package "Services transverses" {
  component "Spring Security\nJWT + RBAC/SBAC" as security
  component "AuditLog / JournalAction" as audit
  component "OpenAPI / Swagger UI" as openapi
  component "GED + PDF + Excel" as documents
  component "Notifications + JavaMail" as notifications
}

users -down-> frontend
frontend -down-> controllers : HTTPS / JSON
controllers -down-> business : DTO valides
business -down-> mapping
mapping -down-> repositories
repositories -down-> database : JPA / SQL

security -left..> controllers : filtre les requetes
security -left..> business : controle les droits
audit -left..> business : trace les mutations
openapi -left..> controllers : documente
documents -left..> business : genere et archive
notifications -left..> business : diffuse les alertes

note right of controllers
  Auth - Utilisateur - Vehicule - Demande
  Affectation - Carburant - Maintenance
  Assurance - Sinistre - Budget
end note
@enduml

