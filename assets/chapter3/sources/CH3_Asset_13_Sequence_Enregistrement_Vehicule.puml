@startuml
!include _theme.puml
title Sequence - Enregistrement et qualification d'un vehicule
autonumber

actor "Gestionnaire Local" as gl
participant "VehiculesListView\nReact" as view
participant VehiculeController as controller
participant VehiculeService as service
database VehiculeRepository as repo

gl -> view : remplir le formulaire vehicule
view -> controller : POST /api/vehicules (VehiculeRequest)
controller -> service : creerVehicule(dto)
service -> repo : existsByImmatriculation / existsByNumeroChassis
repo --> service : resultat

alt immatriculation ou chassis deja present
  service --> controller : ConflictException
  controller --> view : HTTP 409 ApiResponse(error)
  view --> gl : message "vehicule deja enregistre"
else donnees valides
  service -> repo : save(vehicule)\n[statut=DISPONIBLE, etat=NEUF]
  repo --> service : Vehicule persiste
  service --> controller : VehiculeResponse
  controller --> view : HTTP 201 ApiResponse<VehiculeResponse>
  view --> gl : vehicule ajoute au registre
end

gl -> view : changer le statut administratif
view -> controller : PUT /api/vehicules/{id}/statut
controller -> service : changerStatut(id, statut, motif)
service -> repo : save(HistoriqueStatutVehicule)
service --> controller : ok
controller --> view : HTTP 200 ApiResponse
@enduml
