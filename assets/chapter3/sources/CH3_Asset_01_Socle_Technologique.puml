@startuml
!include _theme.puml
title Socle technologique - Park Auto MEF
left to right direction
skinparam RectangleFontSize 15
skinparam RectangleFontStyle bold

rectangle "<b>INTERFACE UTILISATEUR</b>\n\nReact 18\nTypeScript\nVite\nReact Router\nAxios\nRecharts" as ui #E9F7F9
rectangle "<b>API REST & SECURITE</b>\n\nJava 17\nSpring Boot 3.3\nSpring MVC REST\nSpring Security\nJWT Access + Refresh\nOpenAPI / Swagger" as api #EEF4F8
rectangle "<b>METIER & DONNEES</b>\n\nServices @Transactional\nDTO + Bean Validation\nMapStruct\nSpring Data JPA\nPostgreSQL / H2" as domain #FFFFFF
rectangle "<b>DOCUMENTS & INTEGRATIONS</b>\n\nOpenPDF\nApache POI\nJavaMailSender\nGED" as docs #FFF9ED
rectangle "<b>QUALITE & EXPLOITATION</b>\n\nMaven\nJUnit 5 + MockMvc\nGit / GitHub\nDocker Compose\nNginx + TLS" as ops #F3F5F8

ui -right-> api : HTTPS / JSON
api -right-> domain : DTO valides
domain -right-> docs : documents et alertes
docs -right-> ops : build et deploiement

note bottom of domain
  Architecture coherente : interface, exposition REST,
  regles metier, persistance et services transverses.
end note
@enduml

