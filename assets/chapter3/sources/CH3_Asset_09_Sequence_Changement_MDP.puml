@startuml
!include _theme.puml
title Sequence - Changement obligatoire du mot de passe
autonumber

actor Utilisateur as user
participant "ForceChangePasswordModal\nReact" as modal
participant UtilisateurController as controller
participant UtilisateurService as service
participant PasswordPolicyValidator as policy
participant BCryptPasswordEncoder as bcrypt
database UtilisateurRepository as repo
participant AuditService as audit

modal --> user : navigation bloquee\ndoitChangerMotDePasse = true
user -> modal : ancien MDP + nouveau MDP + confirmation
modal -> controller : PUT /api/utilisateurs/me/password
controller -> service : changePassword(request, user)
service -> repo : findById(user.id)
repo --> service : Utilisateur
service -> bcrypt : matches(ancien, hash)

alt ancien mot de passe incorrect
  bcrypt --> service : false
  service --> controller : erreur AUTH
  controller --> modal : HTTP 401
  modal --> user : ancien mot de passe incorrect
else ancien mot de passe correct
  bcrypt --> service : true
  service -> policy : validate(nouveau, confirmation)
  alt politique invalide ou confirmation differente
    policy --> service : erreurs de validation
    service --> controller : ValidationException
    controller --> modal : HTTP 400 + details
    modal --> user : afficher les criteres non satisfaits
  else politique respectee
    policy --> service : valide
    service -> bcrypt : encode(nouveau mot de passe)
    bcrypt --> service : nouveau hash
    service -> repo : save(hash, doitChangerMotDePasse=false)
    repo --> service : Utilisateur mis a jour
    service -> audit : PASSWORD_CHANGED
    service --> controller : succes
    controller --> modal : HTTP 200
    modal --> user : fermer la modale et ouvrir le dashboard
  end
end
@enduml

