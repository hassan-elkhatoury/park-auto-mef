@startuml
!include _theme.puml
title Vue d'ensemble des modules fonctionnels
left to right direction

rectangle "SECURITE\nUtilisateurs - Roles - JWT - Audit" as security #EEF4F8
rectangle "PARC AUTOMOBILE\nVehicules - Etats - Echeances" as fleet #E9F7F9
rectangle "MISSIONS\nConducteurs - Demandes - Affectations - OM" as missions #FFF9ED
rectangle "EXPLOITATION\nCarburant - Maintenance - TCO" as operations #FFFFFF
rectangle "RISQUES & FINANCE\nAssurances - Sinistres - Budget" as risks #F3F5F8

component "<color:white><b>API REST SECURISEE</b>\nSPRING BOOT</color>" as core #0B2545
database "REFERENTIEL CENTRAL\nVehicules - Organisation - Historique" as data

component "Notifications" as notify
component "GED" as ged
component "Reporting" as report
component "Import / Export" as io
component "Audit" as audit

security --> core
fleet --> core
missions --> core
operations --> core
risks --> core
core --> data

missions --> fleet : affecte vehicule
operations --> fleet : calcule couts et etats
risks --> fleet : couvre et controle
security --> audit
core --> notify
core --> ged
core --> report
core --> io

note bottom of core
  Un socle unique, cinq modules interconnectes,
  une securite et une tracabilite communes.
end note
@enduml
